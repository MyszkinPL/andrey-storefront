generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  OPEN
  PAYMENT_REVIEW
  CLOSED
  CANCELLED
}

enum DeliveryType {
  MANUAL
  AUTO_KEY
}

enum PaymentMethodType {
  MANUAL
  CRYPTO_PAY
}

model User {
  id           String    @id @default(cuid())
  telegramId   BigInt    @unique
  username     String?
  firstName    String
  lastName     String?
  photoUrl     String?
  role         Role      @default(USER)
  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  banReason    String?
  /// Explicit language choice ("ru" | "en"). Null means follow Telegram.
  language     String?
  /// Last language_code reported by Telegram, used when no explicit choice.
  languageCode String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]   @relation("OrderAuthor")
  assigned     Order[]   @relation("OrderAssignee")
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  category     String?
  description  String
  imageDataUrl String?
  priceRub     Int
  deliveryType DeliveryType  @default(MANUAL)
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  keys         ProductKey[]
  specs        ProductSpec[]
}

model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductKey {
  id              String    @id @default(cuid())
  productId       String
  value           String
  createdAt       DateTime  @default(now())
  issuedAt        DateTime?
  issuedToOrderId String?   @unique
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  issuedToOrder   Order?    @relation(fields: [issuedToOrderId], references: [id])
}

model Order {
  id                       String             @id @default(cuid())
  number                   Int                @unique @default(autoincrement())
  subject                  String
  status                   OrderStatus        @default(OPEN)
  createdById              String
  assignedToId             String?
  productId                String?
  productTitleSnapshot     String?
  productCategorySnapshot  String?
  priceRubSnapshot         Int?
  paymentMethodId          String?
  paymentMethodType        PaymentMethodType?
  paymentMethodTitle       String?
  paymentMethodDetails     String?
  paymentMethodIconDataUrl String?
  deliveredKeyValue        String?
  isPaid                   Boolean            @default(false)
  cryptoInvoiceId          String?
  cryptoInvoiceUrl         String?
  cryptoInvoiceStatus      String?
  cryptoInvoiceAsset       String?
  cryptoInvoiceAmount      String?
  cryptoInvoiceExpiresAt   DateTime?
  paymentConfirmedAt       DateTime?
  manualPaymentRequestedAt DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  closedAt                 DateTime?
  createdBy                User               @relation("OrderAuthor", fields: [createdById], references: [id])
  assignedTo               User?              @relation("OrderAssignee", fields: [assignedToId], references: [id])
  product                  Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  paymentMethod            PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  deliveredKey             ProductKey?
  receipt                  OrderReceipt?
}

/// Buyer-uploaded payment receipt. The PDF itself lives in Telegram: we send
/// it to the admin chat through the bot and keep only the file reference, so
/// the database stays small and the admin sees the receipt in their chat.
model OrderReceipt {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  telegramFileId       String
  telegramFileUniqueId String?
  fileName             String
  fileSize             Int
  uploadedAt           DateTime @default(now())
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id                   String            @id @default(cuid())
  title                String
  type                 PaymentMethodType @default(MANUAL)
  details              String
  iconDataUrl          String?
  cryptoAcceptedAssets String?
  isActive             Boolean           @default(true)
  sortOrder            Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  orders               Order[]
}

model ShopSettings {
  id                     Int      @id @default(1)
  shopName               String   @default("Andrey Store")
  supportUsername        String?
  cryptoPayEnabled       Boolean  @default(false)
  cryptoPayToken         String?
  cryptoPayUseTestnet    Boolean  @default(false)
  cryptoPayFiat          String   @default("RUB")
  cryptoPayDefaultAssets String?
  updatedAt              DateTime @updatedAt
}
