generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  OPEN
  PAYMENT_REVIEW
  CLOSED
  CANCELLED
}

enum DeliveryType {
  MANUAL
  AUTO_KEY
}

enum PaymentMethodType {
  MANUAL
  CRYPTO_PAY
}

model User {
  id           String    @id @default(cuid())
  telegramId   BigInt    @unique
  username     String?
  firstName    String
  lastName     String?
  photoUrl     String?
  role         Role      @default(USER)
  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  banReason    String?
  /// Explicit language choice ("ru" | "en"). Null means follow Telegram.
  language     String?
  /// Last language_code reported by Telegram, used when no explicit choice.
  languageCode String?
  /// First time this person talked to the bot itself, as opposed to only
  /// opening the mini app. Drives the "started the bot" statistic.
  botStartedAt DateTime?
  /// Last time the bot saw them, so the stats can show who is still around.
  botLastSeenAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]   @relation("OrderAuthor")
  assigned     Order[]   @relation("OrderAssignee")
  productViews ProductView[]

  @@index([role])
  @@index([isBanned])
  @@index([createdAt])
  @@index([botStartedAt])
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  category       String?
  description    String
  imageDataUrl   String?
  /// Set whenever the cover changes; lets queries know an image exists and
  /// gives its URL a cache key without reading the base64 blob.
  imageUpdatedAt DateTime?
  priceRub       Int
  deliveryType   DeliveryType  @default(MANUAL)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  /// Total card opens, mini app and bot together.
  viewCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orders         Order[]
  keys           ProductKey[]
  specs          ProductSpec[]
  views          ProductView[]

  @@index([isActive, sortOrder])
  @@index([viewCount])
}

/// One row per person per product, so the stats can separate "opened 40 times"
/// from "40 different people looked". Bumping a counter on Product alone could
/// not tell those apart.
model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String
  count     Int      @default(1)
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, lastAt])
  @@index([userId, lastAt])
}

model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductKey {
  id              String    @id @default(cuid())
  productId       String
  value           String
  createdAt       DateTime  @default(now())
  issuedAt        DateTime?
  issuedToOrderId String?   @unique
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  issuedToOrder   Order?    @relation(fields: [issuedToOrderId], references: [id])

  @@index([productId, issuedAt])
}

model Order {
  id                       String             @id @default(cuid())
  number                   Int                @unique @default(autoincrement())
  subject                  String
  status                   OrderStatus        @default(OPEN)
  createdById              String
  assignedToId             String?
  productId                String?
  productTitleSnapshot     String?
  productCategorySnapshot  String?
  priceRubSnapshot         Int?
  paymentMethodId          String?
  paymentMethodType        PaymentMethodType?
  paymentMethodTitle       String?
  paymentMethodDetails     String?
  paymentMethodIconDataUrl String?
  deliveredKeyValue        String?
  isPaid                   Boolean            @default(false)
  cryptoInvoiceId          String?
  cryptoInvoiceUrl         String?
  cryptoInvoiceStatus      String?
  cryptoInvoiceAsset       String?
  cryptoInvoiceAmount      String?
  cryptoInvoiceExpiresAt   DateTime?
  paymentConfirmedAt       DateTime?
  manualPaymentRequestedAt DateTime?
  /// The buyer removed this from their own history. The order itself stays:
  /// the shop still needs the record, so this only hides the buyer's copy.
  hiddenByBuyerAt          DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  closedAt                 DateTime?
  createdBy                User               @relation("OrderAuthor", fields: [createdById], references: [id])
  assignedTo               User?              @relation("OrderAssignee", fields: [assignedToId], references: [id])
  product                  Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  paymentMethod            PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  deliveredKey             ProductKey?
  receipt                  OrderReceipt?

  @@index([createdById, updatedAt])
  @@index([createdById, hiddenByBuyerAt])
  @@index([createdById, status])
  @@index([status, updatedAt])
}

/// Buyer-uploaded payment receipt. The PDF itself lives in Telegram: we send
/// it to the admin chat through the bot and keep only the file reference, so
/// the database stays small and the admin sees the receipt in their chat.
model OrderReceipt {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  telegramFileId       String
  telegramFileUniqueId String?
  fileName             String
  fileSize             Int
  uploadedAt           DateTime @default(now())
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id                   String            @id @default(cuid())
  title                String
  type                 PaymentMethodType @default(MANUAL)
  details              String
  iconDataUrl          String?
  /// Cache key for the icon URL, see Product.imageUpdatedAt.
  iconUpdatedAt        DateTime?
  cryptoAcceptedAssets String?
  isActive             Boolean           @default(true)
  sortOrder            Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  orders               Order[]

  @@index([isActive, sortOrder])
}

model ShopSettings {
  id                     Int      @id @default(1)
  shopName               String   @default("Andrey Store")
  supportUsername        String?
  cryptoPayEnabled       Boolean  @default(false)
  cryptoPayToken         String?
  cryptoPayUseTestnet    Boolean  @default(false)
  cryptoPayFiat          String   @default("RUB")
  cryptoPayDefaultAssets String?
  /// When set, the bot and the mini app ask people to join this channel
  /// before they can order. Stored without the leading "@".
  requiredChannel        String?
  updatedAt              DateTime @updatedAt
}

/// One admin broadcast. Kept so the admin can see what was already sent and
/// how it landed, instead of firing messages into the dark.
model Broadcast {
  id           String    @id @default(cuid())
  text         String
  imageDataUrl String?
  buttonLabel  String?
  buttonUrl    String?
  sentCount    Int       @default(0)
  failedCount  Int       @default(0)
  totalCount   Int       @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdById  String?

  @@index([startedAt])
}
